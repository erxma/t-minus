{
  "name": "@t-minus/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:deps && vite build",
    "build:deps": "pnpm --filter @t-minus/shared build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "pnpm test:unit --run"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "clsx": "^2.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@harshmandan/svaul": "^2.0.0",
    "@isaacs/ttlcache": "^2.1.5",
    "@lucide/svelte": "^1.73.0",
    "@t-minus/shared": "workspace:*",
    "dayjs": "^1.11.23",
    "http-proxy": "^1.18.1",
    "leaflet": "^1.9.4",
    "melt": "^0.44.0",
    "tiny-invariant": "^1.3.3"
  }
}
