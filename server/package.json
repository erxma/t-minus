    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
