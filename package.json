{
  "name": "t-minus",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:app\" \"pnpm dev:server\" \"pnpm dev:shared\" -n app,server,shared --prefix-colors auto",
    "dev:app": "pnpm --filter app dev",
    "dev:server": "pnpm --filter server dev",
    "dev:shared": "pnpm --filter shared dev --preserveWatchOutput"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
